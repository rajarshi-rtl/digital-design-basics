    %ix/load 4, 2, 0;
    %ix/load 5, 0, 0;
    %flag_set/imm 4, 0;
    %assign/vec4/off/d v0x57a13d5a9630_0, 4, 5;
    %load/vec4 v0x57a13d5a9630_0;
    %parti/s 1, 0, 2;
    %ix/load 4, 1, 0;
    %ix/load 5, 0, 0;
    %flag_set/imm 4, 0;
    %assign/vec4/off/d v0x57a13d5a9630_0, 4, 5;
    %load/vec4 v0x57a13d5a9630_0;
    %parti/s 1, 3, 3;
    %ix/load 4, 0, 0;
    %ix/load 5, 0, 0;
    %flag_set/imm 4, 0;
    %assign/vec4/off/d v0x57a13d5a9630_0, 4, 5;
    %jmp T_1;
    .thread T_1;
    .scope S_0x57a13d5971e0;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x57a13d5a9770_0, 0, 1;
T_2.0 ;
    %delay 5, 0;
    %load/vec4 v0x57a13d5a9770_0;
    %inv;
    %store/vec4 v0x57a13d5a9770_0, 0, 1;
    %jmp T_2.0;
    %end;
